# ========================================
# AnimeLog .gitignore
# ========================================

# ----------------------------------------
# Environment & Secrets
# ----------------------------------------
.env
.env.local
.env.development
.env.production
.env*.local
*.pem
secrets.json

# ----------------------------------------
# Python / Backend
# ----------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# Flask / SQLAlchemy
instance/
*.db
*.sqlite3
migrations/versions/*.pyc

# Pytest
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# ----------------------------------------
# Node.js / Frontend
# ----------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Build outputs
frontend/dist/
frontend/build/
*.local

# Vite
*.local
.vite/

# ----------------------------------------
# IDE & Editors
# ----------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (PyCharm, WebStorm)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.#*

# ----------------------------------------
# OS Generated
# ----------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~

# ----------------------------------------
# Logs & Temp Files
# ----------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed
*.pid.lock

# ----------------------------------------
# Testing & Coverage
# ----------------------------------------
coverage/
*.lcov
.nyc_output/

# ----------------------------------------
# Misc
# ----------------------------------------
*.bak
*.tmp
*.temp
.cache/
*.cache
.parcel-cache/

# Docker
docker-compose.override.yml

# Uploaded files (if applicable)
uploads/
static/uploads/
